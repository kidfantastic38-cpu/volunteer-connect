# Server-only. Generate a long random string (32+ characters) for production.
# Never expose this as NEXT_PUBLIC_AUTH_SECRET.
AUTH_SECRET=

# Hosted PostgreSQL connection string. Server-only.
# Never expose this as NEXT_PUBLIC_DATABASE_URL.
# Local Docker example (not a production secret):
# postgres://volunteer:volunteer@127.0.0.1:5432/volunteer_connect
DATABASE_URL=

# Hosted Neon: neon
# Standard TCP Postgres: postgres
# Local development without Docker: pglite
DATABASE_DRIVER=neon

# Optional. Local uploads/data directory for development only.
VOLUNTEER_CONNECT_DATA_DIR=

# Required in production for file uploads (Vercel Blob). Server-only.
BLOB_READ_WRITE_TOKEN=

# Public site origin used in verification emails (no trailing slash).
# Production example: https://your-app.vercel.app
# Local example: http://localhost:3000
APP_URL=

# Brevo (Sendinblue). Required in production to email OTP codes. Server-only.
# Never expose as NEXT_PUBLIC_BREVO_API_KEY.
BREVO_API_KEY=
EMAIL_FROM=

# Development only. Must be unset or false in production.
ALLOW_DEMO_OTP=
